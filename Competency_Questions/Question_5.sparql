PREFIX src: <https://w3id.org/srcnet#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX schema: <https://schema.org/>

SELECT ?SRCname ?serviceName ?serviceId ?serviceDescription
WHERE {
  ?node a src:RegionalNode ;
          schema:name ?SRCname ;
          src:operatedBy ?org .
  
  ?org src:localServiceCatalog ?catalog .
  ?catalog dcat:service ?service .
  ?service schema:name ?serviceName ;
           src:serviceId ?serviceId ;
           schema:description ?serviceDescription .
  
  FILTER(?SRCname = "espSRC")
}
