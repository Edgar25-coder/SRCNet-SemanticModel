PREFIX src: <https://w3id.org/srcnet#>
PREFIX schema: <https://schema.org/>

SELECT ?SRCname ?coreCount ?diskCapacity ?diskUnit
WHERE {
  ?node a src:RegionalNode ;
  schema:name ?SRCname ;
  src:operatedBy ?org .
  
  ?org src:hasComputeResource ?compute .
  ?compute src:hasProcessor ?processor ;
           src:hasDisk ?disk .
  
  ?processor src:coreCount ?coreCount .
  ?disk src:diskCapacity ?diskValue .
  
  ?diskValue schema:value ?diskCapacity .
  
  ?diskValue schema:value ?diskCapacity ;
             schema:unitCode ?diskUnit .

FILTER(?coreCount >= 200 && ?diskCapacity >= 40)
}