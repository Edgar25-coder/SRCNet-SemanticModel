<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:vann="http://purl.org/vocab/vann/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#dataTransferCost">
    <rdfs:label xml:lang="en">data transfer cost</rdfs:label>
    <rdfs:comment xml:lang="en">Cost of data transfer operations.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#StorageCost"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasAlert">
    <rdfs:label xml:lang="en">alert type</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a monitoring service to the alert types it generates, monitors, or reports.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#Alert"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#coreCount">
    <rdfs:label xml:lang="en">core count</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the number of processing cores available in a processor.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Processor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#coverageRadius">
    <rdfs:label xml:lang="en">coverage radius</rdfs:label>
    <rdfs:comment xml:lang="en">Network coverage radius.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#AreaCoverage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasJupyterNotebook">
    <rdfs:label xml:lang="en">has Jupyter notebook</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a data service to a Jupyter Notebook environment used for interactive data analysis, visualization, and scientific computing.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#JupyterNotebook"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#registryType">
    <rdfs:label xml:lang="en">registry type</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the type or role of a registry service within SRCNet, such as dataset registry, service registry, metadata registry, or resource registry.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#supportedFormats">
    <rdfs:label xml:lang="en">supported formats</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies one or more data formats supported, produced, consumed, or delivered by a data service.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#threshold">
    <rdfs:label xml:lang="en">alert threshold</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the threshold value that triggers an alert within a monitoring service.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Alert"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasBandwidth">
    <rdfs:label xml:lang="en">has bandwidth</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a network resource to its bandwidth characteristics.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#NetworkResource"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#Bandwidth"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#latency">
    <rdfs:label xml:lang="en">latency</rdfs:label>
    <rdfs:comment xml:lang="en">RAM access latency.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#RAM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#performance">
    <rdfs:label xml:lang="en">processor performance</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a processor to its computational performance, represented as a quantitative value with an associated measurement unit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Processor"/>
    <rdfs:range rdf:resource="https://schema.org/QuantitativeValue"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#voltage">
    <rdfs:label xml:lang="en">voltage</rdfs:label>
    <rdfs:comment xml:lang="en">RAM operating voltage.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#RAM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#serviceId">
    <rdfs:label xml:lang="en">service identifier</rdfs:label>
    <rdfs:comment xml:lang="en">A unique identifier assigned to a data service within the SRCNet infrastructure.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#equipment">
    <rdfs:label xml:lang="en">equipment</rdfs:label>
    <rdfs:comment xml:lang="en">Network equipment cost.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#NetworkCost"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasPowerConsumption">
    <rdfs:label xml:lang="en">has power consumption</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a storage resource to its power consumption metrics.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#StorageResource"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#PowerConsumption"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#environmentalFactors">
    <rdfs:label xml:lang="en">environmental factors</rdfs:label>
    <rdfs:comment xml:lang="en">Environmental factors affecting latency.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Latency"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasEnergySource">
    <rdfs:label xml:lang="en">has energy source</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an energy label to the energy source or mix of energy sources used by a node.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#EnergyLabel"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#EnergySource"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasResearchTool">
    <rdfs:label xml:lang="en">has research tool</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a data service to a research tool used for scientific analysis, data processing, or research activities.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#ResearchTool"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#frequencyBand">
    <rdfs:label xml:lang="en">frequency band</rdfs:label>
    <rdfs:comment xml:lang="en">Network operating frequency band.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#AreaCoverage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#powerConsumption">
    <rdfs:label xml:lang="en">power consumption</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a compute resource to its power consumption, expressed as a quantitative value with an associated measurement unit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#ComputeResource"/>
    <rdfs:range rdf:resource="https://schema.org/QuantitativeValue"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#activePowerConsumption">
    <rdfs:label xml:lang="en">active power consumption</rdfs:label>
    <rdfs:comment xml:lang="en">Power consumption during active operation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#PowerConsumption"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasStorageResource">
    <rdfs:label xml:lang="en">has storage resource</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a node to a storage resource available within that node.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Node"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#StorageResource"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#supportedDomains">
    <rdfs:label xml:lang="en">supported domains</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the scientific or application domains supported by a data service.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="https://w3id.org/srcnet">
    <dcterms:title xml:lang="en">SRCNet Resource and Service Vocabulary</dcterms:title>
    <dcterms:description xml:lang="en">Preliminary vocabulary for describing SRCNet nodes, computing resources and local service catalogs.</dcterms:description>
    <dcterms:creator>SRCNet</dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <vann:preferredNamespacePrefix>src</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/srcnet#</vann:preferredNamespaceUri>
  </owl:Ontology>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#dataPath">
    <rdfs:label xml:lang="en">data path</rdfs:label>
    <rdfs:comment xml:lang="en">Processor data path characteristics.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Architecture"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasVisualizationTool">
    <rdfs:label xml:lang="en">has visualization tool</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a data service to the visualization tool used for data exploration and visual representation of data.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#VisualizationTool"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#DTN">
    <rdfs:label xml:lang="en">data transfer node</rdfs:label>
    <rdfs:comment xml:lang="en">Associated Data Transfer Node.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#DataCapabilities"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#signalStrength">
    <rdfs:label xml:lang="en">signal strength</rdfs:label>
    <rdfs:comment xml:lang="en">Network signal strength.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#AreaCoverage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#visualizationToolVersion">
    <rdfs:label xml:lang="en">visualization tool version</rdfs:label>
    <rdfs:comment xml:lang="en">Version of the visualization tool.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#VisualizationTool"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#numberOfGPUs">
    <rdfs:label xml:lang="en">number of GPUs</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the number of graphics processing units (GPUs) available in a compute resource.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#GPU"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#deploymentDensity">
    <rdfs:label xml:lang="en">deployment density</rdfs:label>
    <rdfs:comment xml:lang="en">Network deployment density.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#AreaCoverage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#congestion">
    <rdfs:label xml:lang="en">congestion</rdfs:label>
    <rdfs:comment xml:lang="en">Network congestion indicator.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Bandwidth"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#serviceVersion">
    <rdfs:label xml:lang="en">service version</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the version of a data service deployed within the SRCNet infrastructure.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#throughput">
    <rdfs:label xml:lang="en">throughput</rdfs:label>
    <rdfs:comment xml:lang="en">Effective data throughput.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Bandwidth"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#frequency">
    <rdfs:label xml:lang="en">alert frequency</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the frequency at which an alert is generated, evaluated, or reported by a monitoring service.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Alert"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasProcessor">
    <rdfs:label xml:lang="en">has processor</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a compute resource to a processor available within that resource.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#ComputeResource"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#Processor"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#waterEfficiencyWUE">
    <rdfs:label xml:lang="en">water usage effectiveness</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the Water Usage Effectiveness (WUE) value associated with an energy efficiency profile. WUE measures the amount of water used by a facility relative to the energy consumed by its IT equipment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#EnergyEfficiency"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#costOfDowntime">
    <rdfs:label xml:lang="en">cost of downtime</rdfs:label>
    <rdfs:comment xml:lang="en">Cost of service downtime.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#NetworkCost"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#computationalPerformance">
    <rdfs:label xml:lang="en">computational performance</rdfs:label>
    <rdfs:comment xml:lang="en">GPU computational performance.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#GPU"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/srcnet#SRCNet">
    <rdfs:label xml:lang="en">SRCNet</rdfs:label>
    <rdfs:comment xml:lang="en">The SKA Regional Centre Network composed of multiple SRCs and providing globally accessible services and resources for the scientific exploitation of SKA data.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasRAM">
    <rdfs:label xml:lang="en">has RAM</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a compute resource to its RAM resource.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#ComputeResource"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#RAM"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#capacityCost">
    <rdfs:label xml:lang="en">capacity cost</rdfs:label>
    <rdfs:comment xml:lang="en">Cost of storage capacity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#StorageCost"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasArchitecture">
    <rdfs:label xml:lang="en">has architecture</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a processor to its architecture description.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Processor"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#Architecture"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#memoryCapacity">
    <rdfs:label xml:lang="en">memory capacity</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a compute resource to its total memory capacity, represented as a quantitative value with an associated measurement unit.</rdfs:comment>
    <rdfs:range rdf:resource="https://schema.org/QuantitativeValue"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#costOfExpansion">
    <rdfs:label xml:lang="en">cost of expansion</rdfs:label>
    <rdfs:comment xml:lang="en">Network expansion cost.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#AreaCoverage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#numberOfProcessors">
    <rdfs:label xml:lang="en">number of processors</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the number of processors available within a compute resource.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Processor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#idlePowerConsumption">
    <rdfs:label xml:lang="en">idle power consumption</rdfs:label>
    <rdfs:comment xml:lang="en">Power consumption during idle operation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#PowerConsumption"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#processorModel">
    <rdfs:label xml:lang="en">processor model</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the manufacturer, family, or model designation of a processor.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Processor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#energyEfficiencyPUE">
    <rdfs:label xml:lang="en">power usage effectiveness</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the Power Usage Effectiveness (PUE) value associated with an energy efficiency profile. PUE is the ratio between the total facility energy consumption and the energy consumed by IT equipment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#EnergyEfficiency"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#energyReuseFactor">
    <rdfs:label xml:lang="en">energy reuse factor</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the proportion of recovered, recycled, or reused energy associated with an energy source profile.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#EnergySource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#maintenance">
    <rdfs:label xml:lang="en">maintenance</rdfs:label>
    <rdfs:comment xml:lang="en">Network maintenance cost.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#NetworkCost"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasDisk">
    <rdfs:label xml:lang="en">has disk</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a compute resource to a disk resource available within that resource.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#ComputeResource"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#Disk"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#training">
    <rdfs:label xml:lang="en">training</rdfs:label>
    <rdfs:comment xml:lang="en">Training cost.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#NetworkCost"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#totalCostOfOwnership">
    <rdfs:label xml:lang="en">total cost of ownership</rdfs:label>
    <rdfs:comment xml:lang="en">Total storage ownership cost.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#StorageCost"/>
