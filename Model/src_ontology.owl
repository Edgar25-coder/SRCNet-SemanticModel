<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:vann="http://purl.org/vocab/vann/"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#serviceId">
    <rdfs:label xml:lang="en">service identifier</rdfs:label>
    <rdfs:comment xml:lang="en">A unique identifier assigned to a data service within the SRCNet infrastructure.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasComputeResource">
    <rdfs:label xml:lang="en">has compute resource</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a Regional Node to a compute resource providing computational capabilities within that node.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#RegionalNode"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#ComputeResource"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasGPU">
    <rdfs:label xml:lang="en">has GPU</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a compute resource to a graphics processing unit (GPU) available within that resource.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#ComputeResource"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#GPU"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#performance">
    <rdfs:label xml:lang="en">processor performance</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a processor to its computational performance, represented as a quantitative value with an associated measurement unit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Processor"/>
    <rdfs:range rdf:resource="https://schema.org/QuantitativeValue"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#diskCapacity">
    <rdfs:label xml:lang="en">disk capacity</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a disk resource to its storage capacity</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Disk"/>
    <rdfs:range rdf:resource="https://schema.org/QuantitativeValue"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#processorModel">
    <rdfs:label xml:lang="en">processor model</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the manufacturer, family, or model designation of a processor.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Processor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#storageCapacity">
    <rdfs:label xml:lang="en">storage capacity</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a storage resource to its available storage capacity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#StorageResource"/>
    <rdfs:range rdf:resource="https://schema.org/QuantitativeValue"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#globalServiceCatalog">
    <rdfs:label xml:lang="en">global service catalog</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a Regional Node to a global catalog describing datasets and services available across the SRCNet infrastructure.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#RegionalNode"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#GlobalServiceCatalog"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#principalInvestigator">
    <rdfs:label xml:lang="en">principal investigator</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a Regional Node to the person responsible for its scientific or technical coordination.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#RegionalNode"/>
    <rdfs:range rdf:resource="https://schema.org/Person"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#renewableEnergyFactor">
    <rdfs:label xml:lang="en">renewable energy factor</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the proportion of energy obtained from renewable energy sources for a given energy source profile.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#EnergySource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#localServiceCatalog">
    <rdfs:label xml:lang="en">local service catalog</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a Regional Node to a catalog describing the datasets and data services provided by that node.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#RegionalNode"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#LocalServiceCatalog"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasJupyterNotebook">
    <rdfs:label xml:lang="en">has Jupyter notebook</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a data service to a Jupyter Notebook environment used for interactive data analysis, visualization, and scientific computing.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#JupyterNotebook"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasAlert">
    <rdfs:label xml:lang="en">alert type</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a monitoring service to the alert types it generates, monitors, or reports.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#Alert"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#numberOfGPUs">
    <rdfs:label xml:lang="en">number of GPUs</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the number of graphics processing units (GPUs) available in a compute resource.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#ComputeResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasDisk">
    <rdfs:label xml:lang="en">has disk</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a compute resource to a disk resource available within that resource.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#ComputeResource"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#Disk"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#operatedBy">
    <rdfs:label xml:lang="en">operated by</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a Regional Node to the organization responsible for its operation and management.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#RegionalNode"/>
    <rdfs:range rdf:resource="https://schema.org/Organization"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasEnergyEfficiency">
    <rdfs:label xml:lang="en">has energy efficiency profile</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an energy label to energy efficiency metrics describing the operational efficiency of a Regional Node infrastructure.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#EnergyLabel"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#EnergyEfficiency"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#energyEfficiencyPUE">
    <rdfs:label xml:lang="en">power usage effectiveness</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the Power Usage Effectiveness (PUE) value associated with an energy efficiency profile. PUE is the ratio between the total facility energy consumption and the energy consumed by IT equipment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#EnergyEfficiency"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#serviceVersion">
    <rdfs:label xml:lang="en">service version</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the version of a data service deployed within the SRCNet infrastructure.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#toolVersion">
    <rdfs:label xml:lang="en">tool version</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the version of a software tool used by a SRCNet service.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#VisualizationTool"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasEnergyLabel">
    <rdfs:label xml:lang="en">has energy label</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a Regional Node to an energy profile describing energy sources and efficiency metrics associated with the node infrastructure.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#RegionalNode"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#EnergyLabel"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasEnergySource">
    <rdfs:label xml:lang="en">has energy source</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an energy label to the energy source or mix of energy sources used by a Regional Node.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#EnergyLabel"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#EnergySource"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#energyReuseFactor">
    <rdfs:label xml:lang="en">energy reuse factor</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the proportion of recovered, recycled, or reused energy associated with an energy source profile.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#EnergySource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#powerConsumption">
    <rdfs:label xml:lang="en">power consumption</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a compute resource to its power consumption, expressed as a quantitative value with an associated measurement unit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#ComputeResource"/>
    <rdfs:range rdf:resource="https://schema.org/QuantitativeValue"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#internalBandwidth">
    <rdfs:label xml:lang="en">internal network bandwidth</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the internal network throughput capacity available within a network infrastructure resource.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#NetworkResource"/>
    <rdfs:range rdf:resource="https://schema.org/QuantitativeValue"/>
  </owl:ObjectProperty>
  <owl:Ontology rdf:about="https://w3id.org/srcnet">
    <dcterms:title xml:lang="en">SRCNet Resource and Service Vocabulary</dcterms:title>
    <dcterms:description xml:lang="en">Preliminary vocabulary for describing SRCNet nodes, computing resources and local service catalogs.</dcterms:description>
    <dcterms:creator>SRCNet</dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <vann:preferredNamespacePrefix>src</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/srcnet#</vann:preferredNamespaceUri>
  </owl:Ontology>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasStorageResource">
    <rdfs:label xml:lang="en">has storage resource</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a Regional Node to a storage resource available within that node.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#RegionalNode"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#StorageResource"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#externalBandwidth">
    <rdfs:label xml:lang="en">external bandwidth</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a network resource to its external data transfer bandwidth available for communication with external networks and services.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#NetworkResource"/>
    <rdfs:range rdf:resource="https://schema.org/QuantitativeValue"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#clock">
    <rdfs:label xml:lang="en">processor clock frequency</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the operating clock rate of a CPU or processor used in a computing resource</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Processor"/>
    <rdfs:range rdf:resource="https://schema.org/QuantitativeValue"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasVisualizationTool">
    <rdfs:label xml:lang="en">has visualization tool</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a data service to the visualization tool used for data exploration and visual representation of data.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#VisualizationTool"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#numberOfProcessors">
    <rdfs:label xml:lang="en">number of processors</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the number of processors available within a compute resource.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#ComputeResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#supportedDomains">
    <rdfs:label xml:lang="en">supported domains</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the scientific or application domains supported by a data service.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#threshold">
    <rdfs:label xml:lang="en">alert threshold</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the threshold value that triggers an alert within a monitoring service.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Alert"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasProcessor">
    <rdfs:label xml:lang="en">has processor</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a compute resource to a processor available within that resource.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#ComputeResource"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#Processor"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#coreCount">
    <rdfs:label xml:lang="en">core count</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the number of processing cores available in a processor.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Processor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#frequency">
    <rdfs:label xml:lang="en">alert frequency</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the frequency at which an alert is generated, evaluated, or reported by a monitoring service.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#Alert"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/srcnet#SRCNet">
    <rdfs:label xml:lang="en">SRCNet</rdfs:label>
    <rdfs:comment xml:lang="en">The SKA Regional Centre Network, composed of multiple Regional Nodes and providing globally accessible services and resources for the scientific exploitation of SKA data.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#localPath">
    <rdfs:label xml:lang="en">local storage path</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the internal storage location or file system path where a dataset is physically stored within an SRCNet infrastructure.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#resourceRequirements">
    <rdfs:label xml:lang="en">resource requirements</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a data service to the computing resources required for its execution, including processor, memory, and other infrastructure requirements.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#ResourceRequirements"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasResearchTool">
    <rdfs:label xml:lang="en">has research tool</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a data service to a research tool used for scientific analysis, data processing, or research activities.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#ResearchTool"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#hasNetworkResource">
    <rdfs:label xml:lang="en">has network resource</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a Regional Node to a network resource available within that node.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#RegionalNode"/>
    <rdfs:range rdf:resource="https://w3id.org/srcnet#NetworkResource"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/srcnet#memoryCapacity">
    <rdfs:label xml:lang="en">memory capacity</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a compute resource to its total memory capacity, represented as a quantitative value with an associated measurement unit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#ComputeResource"/>
    <rdfs:range rdf:resource="https://schema.org/QuantitativeValue"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#supportedFormats">
    <rdfs:label xml:lang="en">supported formats</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies one or more data formats supported, produced, consumed, or delivered by a data service.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#waterEfficiencyWUE">
    <rdfs:label xml:lang="en">water usage effectiveness</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the Water Usage Effectiveness (WUE) value associated with an energy efficiency profile. WUE measures the amount of water used by a facility relative to the energy consumed by its IT equipment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/srcnet#EnergyEfficiency"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/srcnet#registryType">
    <rdfs:label xml:lang="en">registry type</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the type or role of a registry service within SRCNet, such as dataset registry, service registry, metadata registry, or resource registry.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/srcnet#AuthenticationMethod">
    <rdfs:label xml:lang="en">Authentication Method</rdfs:label>
    <rdfs:comment xml:lang="en">An authentication mechanism supported by an SRCNet service to verify user identities and control access to protected resources.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#ResourceRequirements">
    <rdfs:label xml:lang="en">Resource Requirements</rdfs:label>
    <rdfs:comment xml:lang="en">A description of the processor, memory, storage, and other infrastructure resources required to execute a data service within the SRCNet environment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#EnergyEfficiency">
    <rdfs:label xml:lang="en">Energy Efficiency</rdfs:label>
    <rdfs:comment xml:lang="en">A collection of indicators used to evaluate the operational efficiency of a Regional Node infrastructure, including power and water efficiency metrics.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#GPU">
    <rdfs:label xml:lang="en">GPU</rdfs:label>
    <rdfs:comment xml:lang="en">A graphics processing unit (GPU) providing hardware acceleration capabilities within a compute resource for high-performance computing and data-intensive scientific applications.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#JupyterNotebook">
    <rdfs:label xml:lang="en">Jupyter Notebook</rdfs:label>
    <rdfs:comment xml:lang="en">A Jupyter-based interactive environment provided by SRCNet services for scientific computing, data analysis, visualization, and collaborative research workflows.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#Disk">
    <rdfs:label xml:lang="en">Disk</rdfs:label>
    <rdfs:comment xml:lang="en">A local storage device associated with a compute resource and providing storage capacity for operating systems, applications, temporary data, and processing workloads.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#ComputeResource">
    <rdfs:label xml:lang="en">Compute Resource</rdfs:label>
    <rdfs:comment xml:lang="en">A physical or virtual computing resource providing processing, memory, and accelerator capabilities for data processing and scientific workloads within a Regional Node.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#EnergySource">
    <rdfs:label xml:lang="en">Energy Source</rdfs:label>
    <rdfs:comment xml:lang="en">A source of energy used by a Regional Node infrastructure, characterized by renewable energy and energy reuse factors.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#NetworkResource">
    <rdfs:label xml:lang="en">Network Resource</rdfs:label>
    <rdfs:comment xml:lang="en">A network infrastructure resource providing internal and external connectivity, bandwidth, and data transfer capabilities required for SRCNet operations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#LocalServiceCatalog">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
    <rdfs:label xml:lang="en">Local Service Catalog</rdfs:label>
    <rdfs:comment xml:lang="en">A catalog describing the datasets, data services, and resources provided by a Regional Node within the SRCNet infrastructure.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#Alert">
    <rdfs:label xml:lang="en">Alert</rdfs:label>
    <rdfs:comment xml:lang="en">A notification or monitoring rule associated with a service and used to report operational conditions or threshold violations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#VisualizationTool">
    <rdfs:label xml:lang="en">Visualization Tool</rdfs:label>
    <rdfs:comment xml:lang="en">A software application used within SRCNet services for the visualization, exploration, and analysis of astronomical datasets and derived scientific products.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#RegionalNode">
    <rdfs:label xml:lang="en">Regional Node</rdfs:label>
    <rdfs:comment xml:lang="en">A regional node participating in the SKA Regional Centre Network, providing computing, storage, networking resources, and scientific data services.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#StorageResource">
    <rdfs:label xml:lang="en">Storage Resource</rdfs:label>
    <rdfs:comment xml:lang="en">A physical or virtual resource providing storage capacity for datasets and other digital assets.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#GlobalServiceCatalog">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
    <rdfs:label xml:lang="en">Global Service Catalog</rdfs:label>
    <rdfs:comment xml:lang="en">A catalog describing data services and shared capabilities that are available across the entire SRCNet infrastructure.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#ResearchTool">
    <rdfs:label xml:lang="en">Research Tool</rdfs:label>
    <rdfs:comment xml:lang="en">A software tool used for scientific research, data analysis, data processing, and the execution of research workflows within SRCNet services.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#EnergyLabel">
    <rdfs:label xml:lang="en">Energy Label</rdfs:label>
    <rdfs:comment xml:lang="en">Describes the energy characteristics of a Regional Node, including energy sources and efficiency indicators.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/srcnet#Processor">
    <rdfs:label xml:lang="en">Processor</rdfs:label>
    <rdfs:comment xml:lang="en">A central processing unit (CPU) providing general-purpose computational capabilities within a compute resource.</rdfs:comment>
  </owl:Class>
</rdf:RDF>
