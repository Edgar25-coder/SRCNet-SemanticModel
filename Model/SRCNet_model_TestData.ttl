<https://w3id.org/srcnet/node/cansrc> a src:RegionalNode ;
    schema:name "canSRC" ;
    src:operatedBy [ a schema:Organization ;
            schema:contactPoint [ a schema:ContactPoint ;
                    schema:email "infosrc@canadian.src.ca" ;
                    schema:faxNumber "+1 416 123 3360" ;
                    schema:name "canSRC Team" ;
                    schema:telephone "+1 410 123 3566" ;
                    schema:url "not defined" ] ;
            schema:location [ a schema:Place ;
                    schema:address [ a schema:PostalAddress ;
                            schema:addressCountry [ a schema:Country ;
                                    schema:containedInPlace [ a schema:AdministrativeArea ;
                                            schema:name "North America" ] ;
                                    schema:name "Canada" ] ;
                            schema:addressLocality "Victoria" ;
                            schema:addressRegion "not defined" ;
                            schema:postalCode "not available" ;
                            schema:streetAddress "Cedar Lane 45, Victoria, BC V8X 2Y9, Canada" ] ;
                    schema:geo [ a schema:GeoCoordinates ;
                            schema:latitude 4.843e+01 ;
                            schema:longitude -1.2336e+02 ] ] ;
            schema:name "CADC" ;
            src:globalServiceCatalog <https://w3id.org/srcnet/catalog/srcnet-global> ;
            src:hasComputeResource [ a src:ComputeResource ;
                    src:hasDisk [ a src:Disk ;
                            schema:additionalType "HDD" ;
                            src:diskCapacity [ a schema:QuantitativeValue ;
                                    schema:unitCode "TB" ;
                                    schema:value 1024 ] ] ;
                    src:hasGPU [ a src:GPU ;
                            schema:additionalType "H200" ;
                            src:numberOfGPUs 10 ] ;
                    src:hasProcessor [ a src:Processor ;
                            src:clock [ a schema:QuantitativeValue ;
                                    schema:unitCode "GHz" ;
                                    schema:value 2.6e+00 ] ;
                            src:coreCount 3840 ;
                            src:numberOfProcessors 160 ;
                            src:performance [ a schema:QuantitativeValue ;
                                    schema:unitCode "PETAFLOPS" ;
                                    schema:value 4.2e-02 ] ;
                            src:processorModel "" ] ;
                    src:memoryCapacity [ a schema:QuantitativeValue ;
                            schema:unitCode "GB" ;
                            schema:value 20480 ] ;
                    src:powerConsumption [ a schema:QuantitativeValue ;
                            schema:unitCode "" ;
                            schema:value "" ] ] ;
            src:hasEnergyLabel [ a src:EnergyLabel ;
                    src:hasEnergyEfficiency [ a src:EnergyEfficiency ;
                            src:energyEfficiencyPUE "" ;
                            src:waterEfficiencyWUE "" ] ;
                    src:hasEnergySource [ a src:EnergySource ;
                            src:energyReuseFactor "" ;
                            src:renewableEnergyFactor "" ] ] ;
            src:hasNetworkResource [ a src:NetworkResource ;
                    src:externalBandwidth [ a schema:QuantitativeValue ;
                            schema:unitCode "Gbps" ;
                            schema:value 400 ] ;
                    src:internalBandwidth [ a schema:QuantitativeValue ;
                            schema:unitCode "Gbps" ;
                            schema:value 400 ] ] ;
            src:hasStorageResource [ a src:StorageResource ;
                    src:storageCapacity [ a schema:QuantitativeValue ;
                            schema:unitCode "TB" ;
                            schema:value 7.61856e+03 ] ] ;
            src:localServiceCatalog <https://w3id.org/srcnet/catalog/cansrc-local> ;
            src:principalInvestigator [ a schema:Person ;
                    schema:email "clalonde@canadiansrc.ca" ;
                    schema:name "Colton Lalonde" ;
                    schema:telephone "+1 416 123 4567" ;
                    schema:worksFor [ a schema:Organization ;
                            schema:name "CADC" ] ] ] .

